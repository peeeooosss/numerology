generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Coach {
  id                String             @id @default(cuid())
  slug              String             @unique
  customDomain      String?            @unique
  fullName          String
  email             String
  domain            String
  status            String             @default("pending")
  followerCount     String?
  socialHandle      String?
  platformUrl       String?
  createdAt         DateTime           @default(now())
  AdminUser         AdminUser[]
  availabilitySlots AvailabilitySlot[]
  clients           Client[]
  Consultation      Consultation[]
  Course            Course[]
  Lead              Lead[]
  Meeting           Meeting[]
  ReportSale        ReportSale[]
  Resource          Resource[]
}

model Client {
  id               String            @id @default(cuid())
  coachId          String
  name             String
  fullBirthName    String?
  currentName      String?
  dateOfBirth      String
  email            String?
  phone            String?
  focusArea        String?
  question         String?
  goal             String?
  createdAt        DateTime          @default(now())
  coach            Coach             @relation(fields: [coachId], references: [id], onDelete: Cascade)
  dailyPredictions DailyPrediction[]
  dashboardAccess  DashboardAccess?
  Enrollment       Enrollment[]
  reports          Report[]
  sessions         Session[]
  userAccount      UserAccount?

  @@index([coachId, createdAt])
  @@index([coachId, email])
}

model Report {
  id                  String    @id @default(cuid())
  clientId            String
  lifePathNumber      Int
  expressionNumber    Int
  soulUrgeNumber      Int
  personalityNumber   Int
  personalYearNumber  Int
  luckyNumbers        String
  numerologyFactsJson String
  paymentStatus       String    @default("pending")
  paymentId           String?   @unique
  amountPaid          Int       @default(99)
  reportStatus        String    @default("pending")
  pdfPath             String?
  pdfBytes            String?
  generatedAt         DateTime?
  aiContentJson       String?
  aiModel             String?
  aiStatus            String    @default("pending")
  aiPromptVersion     String?
  methodologyVersion  String?
  aiGeneratedAt       DateTime?
  aiInputTokens       Int?
  aiOutputTokens      Int?
  reportType          String    @default("basic")
  driverNumber        Int?
  conductorNumber     Int?
  missingNumberCount  Int?
  loShuFactsJson      String?
  createdAt           DateTime  @default(now())
  client              Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model UserAccount {
  id                  String        @id @default(cuid())
  clientId            String        @unique
  username            String        @unique
  passwordHash        String
  status              String        @default("active")
  mustChangePassword  Boolean       @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  client              Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authSessions        AuthSession[]
}

model AuthSession {
  id              String       @id @default(cuid())
  tokenHash       String       @unique
  userAccountId   String?
  adminUserId     String?
  expiresAt       DateTime
  lastUsedAt      DateTime?
  createdAt       DateTime     @default(now())
  userAccount     UserAccount? @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  adminUser       AdminUser?   @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([userAccountId, expiresAt])
  @@index([adminUserId, expiresAt])
}

model Session {
  id                  String            @id @default(cuid())
  clientId            String
  availabilitySlotId  String?
  focusArea           String
  subFocusArea        String?
  serviceType         String            @default("numerology")
  pricePaid           Int               @default(999)
  scheduledAt         String
  duration            Int               @default(15)
  status              String            @default("booked")
  paymentId           String?           @unique
  question            String?
  desiredOutcome      String?
  additionalContext   String?
  intakeResponsesJson String?
  adminAnalysisJson   String?
  notes               String?
  meetingLink         String?
  createdAt           DateTime          @default(now())
  availabilitySlot    AvailabilitySlot? @relation(fields: [availabilitySlotId], references: [id])
  client              Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model AvailabilitySlot {
  id          String    @id @default(cuid())
  coachId     String
  startsAt    DateTime
  endsAt      DateTime
  timezone    String    @default("Asia/Kolkata")
  capacity    Int       @default(1)
  bookedCount Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  coach       Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  sessions    Session[]

  @@unique([coachId, startsAt, endsAt])
  @@index([coachId, startsAt, isActive])
}

model DashboardAccess {
  id        String    @id @default(cuid())
  clientId  String    @unique
  grantedAt DateTime  @default(now())
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model DailyPrediction {
  id           String   @id @default(cuid())
  clientId     String
  date         String
  luckyNumbers String
  energyScore  Int
  dos          String
  donts        String
  prediction   String
  theme        String
  personalDay  Int
  createdAt    DateTime @default(now())
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date])
  @@index([clientId, createdAt])
}

model Interpretation {
  id           String   @id @default(cuid())
  numberKey    String   @unique
  title        String
  summary      String
  fullText     String
  strengths    String
  challenges   String
  careerGuide  String?
  loveGuide    String?
  healthNotes  String?
  luckyNumbers String
  colors       String
  gemstones    String
  affirmations String
  vedicNotes   String?
  dos          String?
  donts        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminUser {
  id           String  @id
  email        String  @unique
  passwordHash String
  role         String  @default("master_admin")
  coachId      String?
  Coach        Coach?  @relation(fields: [coachId], references: [id])
  authSessions AuthSession[]

  @@index([coachId])
}

model AgencyAvailabilitySlot {
  id            String          @id
  startsAt      DateTime
  endsAt        DateTime
  timezone      String          @default("Asia/Kolkata")
  capacity      Int             @default(1)
  bookedCount   Int             @default(0)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  AgencyBooking AgencyBooking[]

  @@unique([startsAt, endsAt])
  @@index([startsAt, isActive])
}

model AgencyBooking {
  id                     String                 @id
  applicationId          String
  slotId                 String
  scheduledAt            DateTime
  status                 String                 @default("scheduled")
  amount                 Int                    @default(99)
  paymentStatus          String                 @default("pending")
  paymentId              String?                @unique
  refundStatus           String                 @default("not_requested")
  createdAt              DateTime               @default(now())
  Application            Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  AgencyAvailabilitySlot AgencyAvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([applicationId, status])
  @@index([slotId, scheduledAt])
}

model Application {
  id                String          @id
  fullName          String
  email             String
  domain            String
  socialHandle      String
  platformUrl       String
  followerCount     String
  bookingMethod     String
  understand        Boolean
  eligibilityStatus String          @default("pending")
  status            String          @default("submitted")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  AgencyBooking     AgencyBooking[]

  @@index([eligibilityStatus, status])
  @@index([email])
}

model Consultation {
  id         String   @id
  coachId    String
  amount     Int
  coachShare Int
  buyerEmail String?
  paidAt     DateTime @default(now())
  Coach      Coach    @relation(fields: [coachId], references: [id])
}

model Course {
  id           String         @id
  coachId      String
  title        String
  slug         String
  description  String?
  coverUrl     String?
  isPublished  Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  Coach        Coach          @relation(fields: [coachId], references: [id], onDelete: Cascade)
  CourseModule CourseModule[]
  Enrollment   Enrollment[]

  @@unique([coachId, slug])
  @@index([coachId, isPublished])
}

model CourseModule {
  id        String   @id
  courseId  String
  title     String
  sortOrder Int      @default(0)
  Course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  Lesson    Lesson[]

  @@index([courseId, sortOrder])
}

model Enrollment {
  id             String           @id
  courseId       String
  clientId       String
  status         String           @default("active")
  createdAt      DateTime         @default(now())
  Client         Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  Course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  LessonProgress LessonProgress[]

  @@unique([courseId, clientId])
  @@index([clientId, status])
}

model Lead {
  id              String    @id
  coachId         String
  name            String
  email           String
  phone           String?
  source          String?
  status          String    @default("new")
  applicantDomain String?
  socialHandle    String?
  platformUrl     String?
  followerCount   String?
  bookingMethod   String?
  understand      Boolean?
  createdAt       DateTime  @default(now())
  Coach           Coach     @relation(fields: [coachId], references: [id])
  Meeting         Meeting[]
}

model Lesson {
  id             String           @id
  moduleId       String
  title          String
  description    String?
  videoUrl       String?
  content        String?
  duration       Int?
  sortOrder      Int              @default(0)
  isPublished    Boolean          @default(false)
  createdAt      DateTime         @default(now())
  CourseModule   CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  LessonProgress LessonProgress[]
  Resource       Resource[]

  @@index([moduleId, sortOrder])
}

model LessonProgress {
  id           String     @id
  enrollmentId String
  lessonId     String
  completedAt  DateTime?
  updatedAt    DateTime
  Enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  Lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

model Meeting {
  id          String   @id
  coachId     String
  leadId      String?
  scheduledAt DateTime
  type        String
  status      String   @default("scheduled")
  notes       String?
  createdAt   DateTime @default(now())
  Coach       Coach    @relation(fields: [coachId], references: [id])
  Lead        Lead?    @relation(fields: [leadId], references: [id])
}

model ReportSale {
  id         String   @id
  coachId    String
  amount     Int
  coachShare Int
  buyerEmail String?
  paidAt     DateTime @default(now())
  Coach      Coach    @relation(fields: [coachId], references: [id])
}

model Resource {
  id           String   @id
  coachId      String
  lessonId     String?
  title        String
  resourceUrl  String
  resourceType String   @default("link")
  createdAt    DateTime @default(now())
  Coach        Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  Lesson       Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([coachId, createdAt])
}
