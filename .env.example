DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
COACH_SLUG="vinod-numerology"

# OpenRouter. Keep this server-only and never prefix it with NEXT_PUBLIC_.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-5"
OPENROUTER_FALLBACK_MODEL="google/gemini-2.5-pro"
OPENROUTER_MAX_OUTPUT_TOKENS="6000"
OPENROUTER_PRIMARY_TIMEOUT_MS="120000"
OPENROUTER_FALLBACK_TIMEOUT_MS="45000"

# Razorpay
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"

NEXT_PUBLIC_APP_URL="http://localhost:7777"
REPORTS_STORAGE="local"
REPORTS_DIR="./public/reports"

# Authentication and dashboard invitations
AUTH_SESSION_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@magicofnumbers.in"
ADMIN_PASSWORD="replace-before-deploying"
EMAIL_FROM="Magic of Numbers <support@magicofnumbers.in>"
RESEND_API_KEY=""
